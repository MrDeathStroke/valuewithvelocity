# Vercel server-side environment variables.
# Copy to .env.local for local dev. NEVER commit real values.

# Required — Resend API key for the /api/subscribe newsletter endpoint
RESEND_API_KEY=

# Optional — file subscribers into a specific audience in Resend
RESEND_AUDIENCE_ID=

# Optional — sender address. Defaults to onboarding@resend.dev which works
# without domain verification. Switch to a branded sender after verifying
# valuewithvelocity.com in Resend.
RESEND_FROM=

# Optional — Reply-To header on welcome emails
RESEND_REPLY_TO=
